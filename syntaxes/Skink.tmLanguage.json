{
  "name": "Skink",
  "scopeName": "source.skink",
  "fileTypes": [".skink"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.skink",
          "begin": "///",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.skink" }
          }
        },
        {
          "name": "comment.block.skink",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.skink" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.skink" }
          }
        },
        {
          "name": "comment.line.double-slash.skink",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.skink" }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.skink",
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.begin.skink" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.end.skink" }
          },
          "patterns": [
            {
              "match": "\\b(cuda|packed|inline|no_inline|hot|cold|test|bench|no_return|noreturn|must_use|deprecated|volatile|atomic|simd|static)\\b",
              "name": "entity.other.attribute-name.skink"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "entity.other.attribute-name.skink"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.skink",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.skink" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.skink" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.skink",
              "match": "\\\\(\\\\|\"|n|r|t|0|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        },
        {
          "name": "string.quoted.single.byte.skink",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.skink" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.skink" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.skink",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.float.skink",
          "match": "\\b\\d+[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.skink",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.skink",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.skink",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.skink",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.skink",
          "match": "\\b(if|else|for|in|range|while|until|return|break|continue|defer|match|with|comptime|unsafe|async|await|spawn|select|switch|case|default|when|action|priority|rule|ruleset|extern|from|where|orderby|ascending|descending|group|by|join|into)\\b"
        },
        {
          "name": "keyword.other.skink",
          "match": "\\b(fn|pub|const|var|struct|enum|service|module|import|sizeof|alignof|min|max|template|impl)\\b"
        },
        {
          "name": "keyword.operator.logical.skink",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.skink",
          "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|bool|string|bytes|void|error)\\b"
        },
        {
          "name": "storage.type.collection.skink",
          "match": "\\b(chan|tensor|set|map)\\b"
        },
        {
          "name": "storage.type.skink",
          "match": "\\b(nil)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.skink",
          "match": "\\b(true|false|nil|iota)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.skink",
          "match": "(\\+\\=|\\-\\=|\\*\\=|/\\=|%\\=|&\\=|\\|\\=|\\^\\=|<<\\=|>>\\=)"
        },
        {
          "name": "keyword.operator.comparison.skink",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.skink",
          "match": "(\\&\\&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.skink",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.arithmetic.skink",
          "match": "(\\+\\+?|\\-\\-?|\\*\\*?|/|%|@)"
        },
        {
          "name": "keyword.operator.assignment.skink",
          "match": "(=|:\\=|<\\-|->|\\.\\.)"
        },
        {
          "name": "keyword.operator.other.skink",
          "match": "(\\?|\\.\\*|::|=>)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.skink",
          "begin": "\\bfn\\b",
          "end": "(?=[^A-Za-z0-9_])",
          "beginCaptures": {
            "0": { "name": "keyword.other.skink" }
          },
          "patterns": [
            {
              "match": "\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
              "captures": {
                "1": { "name": "entity.name.function.skink" }
              }
            },
            {
              "match": "\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\<)",
              "captures": {
                "1": { "name": "entity.name.function.skink" }
              }
            }
          ]
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.skink"
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\<[^=])",
          "name": "entity.name.function.call.skink"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.skink"
        },
        {
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b",
          "name": "variable.other.skink"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.accessor.skink",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.skink",
          "match": ","
        },
        {
          "name": "punctuation.terminator.skink",
          "match": ";"
        },
        {
          "name": "punctuation.section.block.begin.skink",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.skink",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.skink",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.skink",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.skink",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.skink",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.colon.skink",
          "match": ":"
        }
      ]
    }
  }
}
